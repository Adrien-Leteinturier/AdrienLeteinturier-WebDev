{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/projet/browser",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/contact.mjs": {
      "maxDuration": 30
    }
  },
  "installCommand": "node --version && npx --yes npm@12.0.2 ci"
}
